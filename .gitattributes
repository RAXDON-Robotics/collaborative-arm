# 统一文本行尾为 LF，避免 Windows 检出时脚本被转成 CRLF
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.launch text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.rules text eol=lf
*.rviz text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
package.xml text eol=lf
*.msg text eol=lf

# 二进制
*.so binary
*.dll binary
*.stl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ply binary
*.pcd binary
*.bag binary
